{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Crisis Dialogue Input Schema",
    "type": "object",
    "required": ["dialogue_id", "turns"],
    "properties": {
        "dialogue_id": { "type": "string" },
        "turns": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": ["turn_id", "speaker", "text", "label"],
                "properties": {
                    "turn_id": { "type": "integer" },
                    "speaker": { "type": "string" },
                    "text": { "type": "string", "minLength": 1 },
                    "label": {
                        "type": "string",
                        "enum": ["normal", "alert", "confirm"]
                    },
                    "rate": { "type": "string", "pattern": "^[+-][0-9]+%$" },
                    "pause_after_ms": { "type": "integer", "minimum": 0 },
                    "emotion": { "type": ["string", "null"] },
                    "arousal": { "type": ["string", "null"] },
                    "paralinguistic_events": { "type": "array" }
                }
            }
        }
    }
}
