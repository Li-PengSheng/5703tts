# Future generated output and logs; already tracked historical files stay tracked.
/data/output/*
!/data/output/.gitkeep
/logs/*
!/logs/.gitkeep
/data/benchmark/runs/

# Ignore generated speaker-pool WAVs except frozen tracked v0.2 production assets.
/data/speaker_pool/*/references/*.wav
!/data/speaker_pool/vctk_v0.2/references/*.wav
/data/speaker_pool/*/smoke_runs/

# Windows download metadata (can appear as real sidecar files outside NTFS)
*:Zone.Identifier

# Python cache
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Local virtual environments
.venv/
venv/

# External TTS repositories, their environments, and downloaded model artifacts
/third_party/
/models/

# Build and packaging artifacts
build/
dist/
*.egg-info/

# Local model cache (if a Hugging Face cache is created in the project directory)
*.pt
*.safetensors

# OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
.vs/
.vsls.json

/vctk-speaker/
/VCTK-Corpus-0.92.zip
/comp5703-tts-experiments
/data/smoke
