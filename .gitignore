# Generated output: not version-controlled and recreated on every run
data/output/*
!data/output/.gitkeep
/data/benchmark/runs/
logs/*.log

# Speaker-pool reference audio and smoke runs: reproducibly regenerated from the
# local VCTK corpus by scripts/materialize_vctk_speaker_pool.py
/data/speaker_pool/*/references/*.wav
/data/speaker_pool/*/smoke_runs/

# Windows download metadata (can appear as real sidecar files outside NTFS)
*:Zone.Identifier

# Python cache
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Local virtual environments
.venv/
venv/

# External TTS repositories, their environments, and downloaded model artifacts
/third_party/
/models/

# Build and packaging artifacts
build/
dist/
*.egg-info/

# Local model cache (if a Hugging Face cache is created in the project directory)
*.pt
*.safetensors

# OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
.vs/
.vsls.json

/vctk-speaker/
/VCTK-Corpus-0.92.zip
